        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n  subgraph REQ[\&quot;📤 REQUEST\&quot;]\n    R1[\&quot;POST /search/hybrid-search&lt;br/&gt;query=&#39;política monetaria&#39;&lt;br/&gt;slug=&#39;buscador-de-normas-legales&#39;&lt;br/&gt;filters=[category, status, keywords]&lt;br/&gt;facets=[publication_year, category, status, keywords]&lt;br/&gt;include_summary=true&lt;br/&gt;page=1, per_page=5&lt;br/&gt;sort_by=last, sort_ord=asc\&quot;]\n  end\n\n  subgraph API[\&quot;1️⃣ API GATEWAY\&quot;]\n    P0[\&quot;Rate Limit: 60/min (slowapi)\&quot;]\n    P1[\&quot;Pydantic Validation&lt;br/&gt;HybridSearchRequest\&quot;]\n  end\n\n  subgraph CACHE[\&quot;2️⃣ CACHE LAYER\&quot;]\n    CG[\&quot;content_guard&lt;br/&gt;check_content(&#39;política monetaria&#39;)&lt;br/&gt;→ blocklist miss → PASS\&quot;]\n    CK[\&quot;_build_cache_key(...) → cache_key&lt;br/&gt;Redis GET → MISS\&quot;]\n    SF[\&quot;acquire_search_lock(key)&lt;br/&gt;→ SETNX → OK (first req)\&quot;]\n  end\n\n  subgraph MODCONFIG[\&quot;3️⃣ MODULE CONFIG\&quot;]\n    MC[\&quot;ModuleConfigService.get_module_setup(&#39;buscador-de-normas-legales&#39;)&lt;br/&gt;→ RAM lookup (hybrid_modules_config.json)\&quot;]\n    MC1[\&quot;system_filters: {`$or`: [{dimension: &#39;legal&#39;}]}&lt;br/&gt;required_facets: [publication_year, category, status, keywords]&lt;br/&gt;sorting: [recent, last, title_a_z, title_z_a]\&quot;]\n  end\n\n  subgraph SORT[\&quot;4️⃣ SORT RESOLUTION\&quot;]\n    SR[\&quot;_resolve_sort(&#39;last&#39;, &#39;asc&#39;, sorting)\&quot;]\n    SR1[\&quot;→ field=&#39;published_at&#39;, direction=&#39;ASC&#39;\&quot;]\n  end\n\n  subgraph FILTERS[\&quot;5️⃣ FILTER NORMALIZATION\&quot;]\n    FP[\&quot;build_user_filters(raw_filters, system_filters)\&quot;]\n    FN1[\&quot;FilterNormalizer.normalize(&#39;category&#39;, &#39;circulares&#39;)&lt;br/&gt;→ DynamicCatalog + YAML aliases&lt;br/&gt;→ &#39;circulares&#39;\&quot;]\n    FN2[\&quot;FilterNormalizer.normalize(&#39;status&#39;, &#39;vigente&#39;)&lt;br/&gt;→ lower → &#39;vigente&#39;&lt;br/&gt;→ _FIELD_MAP[&#39;status&#39;]→&#39;source_status&#39;\&quot;]\n    FN3[\&quot;FilterNormalizer.normalize(&#39;keywords&#39;, [&#39;operaciones cambiarias&#39;])&lt;br/&gt;→ DynamicCatalog + YAML aliases&lt;br/&gt;→ variantes normalizadas&lt;br/&gt;→ _FIELD_MAP→&#39;metadata_keywords&#39;\&quot;]\n    COMB[\&quot;combined_filters = {&lt;br/&gt;  `$or`: [{dimension: &#39;legal&#39;}],&lt;br/&gt;  category: [&#39;circulares&#39;],&lt;br/&gt;  source_status: [&#39;vigente&#39;],&lt;br/&gt;  metadata_keywords: [&#39;operaciones cambiarias&#39;, ...]&lt;br/&gt;}\&quot;]\n  end\n\n  subgraph EMBED[\&quot;6️⃣ EMBEDDING\&quot;]\n    E1[\&quot;is_catalog_browsing=False&lt;br/&gt;(query no vacía)\&quot;]\n    E2[\&quot;model: text-embedding-3-small\&quot;]\n    EC[\&quot;Redis embedding cache → MISS\&quot;]\n    E3[\&quot;OpenAI: client.embeddings.create()&lt;br/&gt;→ vector[1536]\&quot;]\n    E4[\&quot;set_cached_embedding → Redis\&quot;]\n  end\n\n  subgraph PARALLEL[\&quot;7️⃣ PARALLEL EXECUTION (asyncio.gather)\&quot;]\n    direction TB\n    subgraph FACET[\&quot;Task A: Facet Precalculation\&quot;]\n      F1[\&quot;per_page=1, facets=final_facets&lt;br/&gt;→ Oracle GROUP BY × 4\&quot;]\n      F2[\&quot;publication_year: COUNT&lt;br/&gt;category: COUNT&lt;br/&gt;status: COUNT&lt;br/&gt;keywords: COUNT\&quot;]\n    end\n    subgraph MAIN[\&quot;Task B: Main Hybrid Search\&quot;]\n      M1[\&quot;per_page=5, page=1&lt;br/&gt;no facets (solo precalc)\&quot;]\n    end\n  end\n\n  subgraph ORACLE[\&quot;8️⃣ ORACLE SEARCH REPOSITORY\&quot;]\n    O1[\&quot;_sanitize_lexical_query(&#39;política monetaria&#39;)&lt;br/&gt;→ &#39;politica &amp; monetaria&#39;\&quot;]\n    O2[\&quot;_should_use_lexical_search()&lt;br/&gt;→ CONTAINS pre-check → true/false\&quot;]\n    O3[\&quot;_build_filter_clauses(combined_filters):&lt;br/&gt;  AND (JSON_EXISTS dim=legal)&lt;br/&gt;  AND d.CATEGORY IN (:f_category_0_0)&lt;br/&gt;  AND d.SOURCE_STATUS IN (:f_source_status_0_0)&lt;br/&gt;  AND JSON_EXISTS metadata_keywords\&quot;]\n    O4[\&quot;Hybrid Score Formula:&lt;br/&gt;(1 - VECTOR_DISTANCE(COSINE)) × 0.7&lt;br/&gt;+ (SCORE(1)/100) × 0.3\&quot;]\n\n    subgraph SQL[\&quot;SQL EXECUTION\&quot;]\n      OS1[\&quot;COUNT SQL:&lt;br/&gt;COUNT DISTINCT d.DOCUMENT_ID&lt;br/&gt;FROM DOCUMENT_CHUNKS c&lt;br/&gt;JOIN DOCUMENTS d&lt;br/&gt;WHERE CONTAINS + filter_clauses\&quot;]\n      OS2[\&quot;MAIN SQL:&lt;br/&gt;SELECT d.DOCUMENT_ID, TITLE, ABSTRACT,&lt;br/&gt;MAX(hybrid_score) AS SCORE,&lt;br/&gt;RTRIM(XMLAGG(...)) AS CONTEXT_TEXT&lt;br/&gt;GROUP BY documento&lt;br/&gt;ORDER BY published_at ASC NULLS LAST&lt;br/&gt;OFFSET 0 FETCH NEXT 5\&quot;]\n    end\n  end\n\n  subgraph EXTRACT[\&quot;9️⃣ RESPONSE EXTRACTION\&quot;]\n    EX1[\&quot;extract_hybrid_search_payload()&lt;br/&gt;→ results[], facets{}, pagination{}\&quot;]\n    EX2[\&quot;Si facet_precalc tiene datos → facets de precalc&lt;br/&gt;Si no → facets del main search\&quot;]\n  end\n\n  subgraph LLM[\&quot;🔟 LLM SUMMARY\&quot;]\n    L1[\&quot;include_summary=true\&quot;]\n    L2[\&quot;build_hybrid_summary_context(results):&lt;br/&gt;- Top 4 docs by score&lt;br/&gt;- snippet=1500 chars&lt;br/&gt;- max_context=24000 chars\&quot;]\n    L3[\&quot;prompt_key=&#39;interpreter:13&#39;&lt;br/&gt;→ get_cached_prompt()\&quot;]\n    L4[\&quot;system: base_prompt + &#39;Responde en Español&#39;&lt;br/&gt;user: &#39;Contexto... Pregunta: política monetaria&#39;\&quot;]\n    L5[\&quot;OpenAI chat.completions.create()&lt;br/&gt;→ markdown → HTML\&quot;]\n  end\n\n  subgraph ASSEMBLY[\&quot;1️⃣1️⃣ RESPONSE ASSEMBLY\&quot;]\n    A1[\&quot;formatted_results = []\&quot;]\n    A2[\&quot;Append summary result (format: &#39;AI&#39;)\&quot;]\n    A3[\&quot;Append docs (format: &#39;PDF&#39;)&lt;br/&gt;metadata filtrada: _SAFE_METADATA_KEYS\&quot;]\n    A4[\&quot;HybridSearchResponse(&lt;br/&gt;  results=&lt;formatted&gt;,&lt;br/&gt;  facets=&lt;facet_data&gt;,&lt;br/&gt;  pagination=&lt;total,page,pages&gt;,&lt;br/&gt;  metadata={model, locale, status, module_slug}&lt;br/&gt;)\&quot;]\n    A5[\&quot;set_cached_result → Redis (TTL default)\&quot;]\n    A6[\&quot;release_search_lock(cache_key)\&quot;]\n  end\n\n  REQ --&gt; API --&gt; CACHE\n  CACHE --&gt;|cache MISS| MODCONFIG\n  MODCONFIG --&gt; SORT\n  SORT --&gt; FILTERS\n  FILTERS --&gt; EMBED\n  EMBED --&gt; PARALLEL\n  PARALLEL --&gt; ORACLE\n  ORACLE --&gt; EXTRACT\n  EXTRACT --&gt; LLM\n  LLM --&gt; ASSEMBLY&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rdLd7mlDExRLg2rDq3M1-128">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
