        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: \&quot;Reranking Pipeline — Antes vs Después\&quot;\n---\nflowchart TD\n    subgraph BEFORE[\&quot;ANTES — 3 modos (off / diversity / full)\&quot;]\n        direction TB\n        B0[\&quot;Chunks recuperados&lt;br/&gt;de vector search\&quot;]\n\n        B0 --&gt; B1{\&quot;RERANKING_MODE?\&quot;}\n\n        B1 --&gt;|\&quot;off\&quot;| B2[\&quot;Sin reranking&lt;br/&gt;orden original preservado\&quot;]\n        B2 --&gt; B3[\&quot;Retornar chunks\&quot;]\n\n        B1 --&gt;|\&quot;diversity\&quot;| B4[\&quot;Diversity cap&lt;br/&gt;max 3 chunks/doc\&quot;]\n        B4 --&gt; B5[\&quot;MMR Jaccard&lt;br/&gt;lambda=0.5\&quot;]\n        B5 --&gt; B3\n\n        B1 --&gt;|\&quot;full\&quot;| B6[\&quot;Diversity cap&lt;br/&gt;max 3 chunks/doc\&quot;]\n        B6 --&gt; B7[\&quot;MMR Jaccard&lt;br/&gt;lambda=0.5\&quot;]\n        B7 --&gt; B8[\&quot;GPT Cross-Encoder&lt;br/&gt;GPT-4o-mini logprob&lt;br/&gt;1 API call por chunk\&quot;]\n        B8 --&gt; B9{\&quot;GPT OK?\&quot;}\n        B9 --&gt;|\&quot;sí\&quot;| B3\n        B9 --&gt;|\&quot;no — fallback\&quot;| B3\n\n        B8 -.-&gt;|\&quot;❌ Token cost&lt;br/&gt;❌ Latencia extra&lt;br/&gt;❌ Mejora marginal&lt;br/&gt;❌ Complejidad\&quot;| BPROB\n\n        BPROB[\&quot;PROBLEMA&lt;br/&gt;176 líneas código + 272 tests&lt;br/&gt;para una feature que nadie usa\&quot;]\n    end\n\n    subgraph AFTER[\&quot;DESPUÉS — 2 modos (off / diversity)\&quot;]\n        direction TB\n        A0[\&quot;Chunks recuperados&lt;br/&gt;de vector search\&quot;]\n\n        A0 --&gt; A1{\&quot;RERANKING_MODE?\&quot;}\n\n        A1 --&gt;|\&quot;off\&quot;| A2[\&quot;Sin reranking&lt;br/&gt;orden original preservado\&quot;]\n        A2 --&gt; A3[\&quot;Retornar chunks\&quot;]\n\n        A1 --&gt;|\&quot;diversity\&quot;| A4[\&quot;Diversity cap&lt;br/&gt;max 3 chunks/doc\&quot;]\n        A4 --&gt; A5[\&quot;MMR Jaccard&lt;br/&gt;lambda=0.5\&quot;]\n        A5 --&gt; A3\n\n        A4 -.-&gt;|\&quot;✅ Evita que 1 doc domine&lt;br/&gt;✅ Reordena por diversidad léxica\&quot;| ASOL\n        ASOL[\&quot;SOLUCIÓN&lt;br/&gt;-550 líneas eliminadas&lt;br/&gt;gpt_reranker.py + tests borrados&lt;br/&gt;_apply_reranking simplificado&lt;br/&gt;Mismos resultados sin costo extra\&quot;]\n    end\n\n    style B8 fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000\n    style BPROB fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000\n    style B6 fill:#fff2cc,stroke:#d6b656,color:#000\n    style B7 fill:#fff2cc,stroke:#d6b656,color:#000\n\n    style A4 fill:#d5e8d4,stroke:#82b366,color:#000\n    style A5 fill:#d5e8d4,stroke:#82b366,color:#000\n    style ASOL fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rdLd7mlDExRLg2rDq3M1-208">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="DESPUÉS — 2 modos (off / diversity)" mermaidId="n:AFTER" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="DESPUÉS — 2 modos (off / diversity)" id="rdLd7mlDExRLg2rDq3M1-209">
