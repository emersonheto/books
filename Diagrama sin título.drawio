        <mxCell id="rdLd7mlDExRLg2rDq3M1-249" parent="rdLd7mlDExRLg2rDq3M1-208" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=light-dark(#333333,#cccccc);fontFamily=trebuchet ms,verdana,arial,sans-serif;" value="Reranking Pipeline — Antes vs Después" vertex="1">
          <mxGeometry height="25" width="1937" x="1248" y="2095" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: \&quot;Reranking &amp; Search — Antes vs Después\&quot;\n---\nflowchart LR\n    subgraph BEFORE[\&quot;ANTES — queries cortas rompían\&quot;]\n        direction TB\n\n        BQ[\&quot;Usuario busca: &#39;pagos&#39;&lt;br/&gt;en resoluciones-de-directorio\&quot;]\n\n        BQ --&gt; BS[\&quot;Vector search&lt;br/&gt;top_k = 30\&quot;]\n\n        BS --&gt; BT{\&quot;Score threshold&lt;br/&gt;0.60 post-filter\&quot;}\n\n        BT --&gt;|\&quot;scores reales: 0.10–0.22&lt;br/&gt;TODOS por debajo de 0.60\&quot;| BEMPTY\n\n        BEMPTY[\&quot;0 resultados&lt;br/&gt;❌ Búsqueda vacía\&quot;]\n\n        BEMPTY --&gt; BR{\&quot;RERANKING_MODE?&lt;br/&gt;off / diversity / full\&quot;}\n\n        BR -.-&gt;|\&quot;ni siquiera llega&lt;br/&gt;acá\&quot;| BEMPTY\n\n        BNOTE[\&quot;PROBLEMAS&lt;br/&gt;① Threshold 0.60 filtraba todo&lt;br/&gt;② top_k=30 = ~4,900 tokens al LLM&lt;br/&gt;③ full mode: GPT cross-encoder innecesario&lt;br/&gt;④ 3 problemas combinados\&quot;]\n    end\n\n    subgraph AFTER[\&quot;DESPUÉS — sin threshold, diversity limpio\&quot;]\n        direction TB\n\n        AQ[\&quot;Usuario busca: &#39;pagos&#39;&lt;br/&gt;en resoluciones-de-directorio\&quot;]\n\n        AQ --&gt; AS[\&quot;Vector search&lt;br/&gt;top_k = 15\&quot;]\n\n        AS --&gt; AR{\&quot;RERANKING_MODE?&lt;br/&gt;off / diversity\&quot;}\n\n        AR --&gt;|\&quot;diversity default\&quot;| AD[\&quot;Diversity cap&lt;br/&gt;máx 3 chunks por documento\&quot;]\n\n        AD --&gt; AM[\&quot;MMR Jaccard&lt;br/&gt;lambda = 0.5&lt;br/&gt;reordena por diversidad léxica\&quot;]\n\n        AM --&gt; ARESULT[\&quot;15 chunks relevantes&lt;br/&gt;✅ Resultados correctos&lt;br/&gt;~2,500 tokens al LLM\&quot;]\n\n        ANOTE[\&quot;SOLUCIONES&lt;br/&gt;① Threshold eliminado — scores pasan libres&lt;br/&gt;② top_k=15 — 50% menos tokens&lt;br/&gt;③ full mode eliminado — sin costo GPT extra&lt;br/&gt;④ _apply_reranking simplificado\&quot;]\n    end\n\n    BEFORE ==&gt; AFTER\n\n    style BEMPTY fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000\n    style BT fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000\n    style BNOTE fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000\n\n    style AD fill:#d5e8d4,stroke:#82b366,color:#000\n    style AM fill:#d5e8d4,stroke:#82b366,color:#000\n    style ARESULT fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000\n    style ANOTE fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rdLd7mlDExRLg2rDq3M1-250">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=1;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ANTES — queries cortas rompían" mermaidId="n:BEFORE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="ANTES — queries cortas rompían" id="rdLd7mlDExRLg2rDq3M1-251">
